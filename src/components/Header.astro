---
import { SITE } from '../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.author} — home`}>
      <span class="brand-name">{SITE.authorShort}</span>
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-full">{SITE.author}</span>
    </a>
    <nav aria-label="Primary">
      <a href="/#projects" class:list={[{ active: isActive('/projects') }]}>Projects</a>
      <a href="/about" class:list={[{ active: isActive('/about') }]}>About</a>
      <a href={SITE.cv} class="cv-link">CV<span class="cv-ext mono"> PDF</span></a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 650;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-name {
    color: var(--amber);
  }
  .brand-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--amber-dim);
  }
  .brand-full {
    color: var(--text-dim);
    font-weight: 500;
    font-size: 0.95rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 1.75rem);
  }
  nav a {
    color: var(--text-dim);
    font-size: 0.95rem;
    font-weight: 500;
  }
  nav a:hover,
  nav a.active {
    color: var(--text);
    text-decoration: none;
  }
  .cv-link {
    color: var(--amber);
  }
  .cv-ext {
    font-size: 0.7rem;
    color: var(--amber-dim);
  }

  @media (max-width: 480px) {
    .brand-full {
      display: none;
    }
  }
</style>
