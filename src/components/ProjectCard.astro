---
import type { CollectionEntry } from 'astro:content';
import HeroMedia from './HeroMedia.astro';
import ChannelTag from './ChannelTag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}`;
---

<a class:list={['card', { featured }]} href={href}>
  <div class="card-media">
    <HeroMedia
      src={data.hero.src ?? `/images/${project.id}/hero.jpg`}
      alt={data.hero.alt}
      type={data.hero.type}
      ratio={featured ? '16 / 10' : '16 / 9'}
      label="HERO"
      loading="lazy"
    />
  </div>
  <div class="card-body">
    <div class="card-meta">
      <ChannelTag channel={data.channel} />
      <span class="readout card-year">{data.year}</span>
    </div>
    <h3 class="card-title">{data.title}</h3>
    <p class="card-oneliner">{data.oneLiner}</p>
    {data.status && <p class="card-status mono">{data.status}</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease;
    height: 100%;
  }
  .card:hover {
    text-decoration: none;
    border-color: var(--amber-dim);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }

  .card-media :global(img),
  .card-media :global(video),
  .card-media :global(.placeholder) {
    border: 0;
    border-radius: 0;
    border-bottom: 1px solid var(--border);
  }

  .card-body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .card-year {
    font-size: 0.72rem;
  }
  .card-title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .featured .card-title {
    font-size: 1.2rem;
  }
  .card-oneliner {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-dim);
  }
  .card-status {
    margin: 0;
    font-size: 0.75rem;
    color: var(--amber-dim);
  }
</style>
