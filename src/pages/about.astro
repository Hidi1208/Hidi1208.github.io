---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { SITE } from '../lib/site';

const description = `About ${SITE.author}, final-year Electrical and Electronics Engineering student at VIT Vellore. Toastmasters, digital art, and what I'm aiming at next.`;

const artPieces = [
  {
    src: '/images/about/art/violin.webp',
    alt: 'Digital painting of a violin and bow resting on open sheet music.',
    ratio: '3 / 4',
  },
  {
    src: '/images/about/art/portrait.webp',
    alt: 'Digital portrait illustration of a character with dark red hair.',
    ratio: '3 / 4',
  },
  {
    src: '/images/about/art/figure.webp',
    alt: 'Digital illustration of a seated figure holding a camera.',
    ratio: '3 / 4',
  },
  {
    src: '/images/about/art/night-scene.webp',
    alt: 'Digital painting of a figure seated on a fallen tree above still water at night.',
    ratio: '3 / 4',
  },
];
---

<BaseLayout title="About" description={description}>
  <section class="section container about">
    <p class="readout">CH0 · About</p>
    <h1>About</h1>
    <p class="lead">
      I'm from Pune, and I'm in my final year of Electrical &amp; Electronics
      Engineering at VIT Vellore. Most of what I do is firmware and hardware.
      This page is the rest of it.
    </p>

    <div class="about-hero">
      <HeroMedia
        src="/images/about/speaking-1.webp"
        alt="Speaking at the Coruscate 2K25 Division C semi-annual conference."
        ratio="4 / 3"
        label="ON STAGE"
        loading="eager"
      />
      <HeroMedia
        src="/images/about/speaking-2.webp"
        alt="Mid-speech at a Toastmasters contest."
        ratio="4 / 3"
        label="ON STAGE"
        loading="lazy"
      />
    </div>

    <h2>Toastmasters</h2>
    <p>
      I've been part of <strong>Fogo VIT</strong> through 2025, as Secretary for
      the first half of the year and <strong>VP Education</strong> for the
      second, in a club of 50 or so members.
    </p>
    <ul>
      <li>
        <strong>3rd place</strong> in the Humorous Speech Contest at Coruscate,
        the Division C conference (District 120).
      </li>
      <li>Finished the <strong>Dynamic Leadership</strong> Pathway, all 5 levels.</li>
      <li>
        <strong>Secretary Trainer</strong> in the district Officer's Training
        Program.
      </li>
    </ul>

        <h2>Digital art</h2>
    <p>Something I do when I'm not soldering. Mostly still life and figures.</p>

    <div class="art-gallery">
      {
        artPieces.map((piece) => (
          <HeroMedia
            src={piece.src}
            alt={piece.alt}
            ratio={piece.ratio}
            label="ART"
            loading="lazy"
          />
        ))
      }
    </div>
    <p class="art-note">Drawn from reference images found on Pinterest.</p>

     <h2>Where this is going</h2>
    <p>
      I want to start a hardware company eventually, after a master's. The
      projects here are me working out what I'm actually good at.
    </p>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 70ch;
  }
  .lead {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: var(--text);
    margin-bottom: 2rem;
  }
  .about h2 {
    margin-top: 2.5rem;
  }
  .about ul {
    color: var(--text-dim);
    padding-left: 1.2rem;
  }
  .about li {
    margin-bottom: 0.5rem;
  }
  .about strong {
    color: var(--text);
  }
  .about-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1rem 0 1.5rem;
  }
  .art-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
    align-items: start;
  }
  .art-note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  @media (max-width: 480px) {
    .about-hero {
      grid-template-columns: 1fr;
    }
    .art-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
